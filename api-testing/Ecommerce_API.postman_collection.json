        {
          "name": "Add simulated cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "add"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"products\": [\n    {\n      \"id\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"id\": 2,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is success',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const j=pm.response.json(); pm.test('userId retained',()=>pm.expect(j.userId).to.eql(1));",
                  "pm.test('products returned',()=>pm.expect(j.products).to.be.an('array').that.is.not.empty);",
                  "pm.test('new id returned',()=>pm.expect(j.id).to.be.a('number'));"
                ]
              }
            }
          ]
        },
