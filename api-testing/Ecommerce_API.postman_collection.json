                  "const j=pm.response.json(); pm.test('search returns collection',()=>pm.expect(j.products).to.be.an('array'));",
                  "pm.test('total is numeric',()=>pm.expect(j.total).to.be.a('number')); "
                ]
              }
            }
          ]
        },
        {
          "name": "Limit 5 products",
          "request": {
            "method": "GET",
            "header": [
              {
