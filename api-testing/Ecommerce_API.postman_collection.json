{
  "info": {
    "name": "E-Commerce QA - DummyJSON Products & Carts",
    "description": "Portfolio API suite for product/cart positive and negative testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Get all products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.response.to.be.json);",
                  "const j=pm.response.json(); pm.test('products is array',()=>pm.expect(j.products).to.be.an('array'));",
                  "pm.test('pagination fields exist',()=>{pm.expect(j).to.have.property('total');pm.expect(j).to.have.property('skip');pm.expect(j).to.have.property('limit');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.response.to.be.json);",
                  "const j=pm.response.json(); pm.test('id matches',()=>pm.expect(j.id).to.eql(1));",
                  "pm.test('required fields',()=>{['title','price','category'].forEach(k=>pm.expect(j).to.have.property(k));});"
                ]
              }
            }
          ]
        },
